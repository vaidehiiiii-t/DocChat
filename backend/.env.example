FLASK_ENV=development
SECRET_KEY=change-me-development-secret-key-32chars
JWT_SECRET_KEY=change-me-jwt-secret-key-32chars-min
JWT_ACCESS_MINUTES=60

# Database (TiDB Cloud Serverless or MySQL 8)
DATABASE_URL=mysql+pymysql://<user>:<password>@<host>:4000/<database>?ssl_verify_cert=true&ssl_verify_identity=true
TEST_DATABASE_URL=sqlite:///:memory:

UPLOAD_DIR=./storage/uploads
CHROMA_DIR=./storage/chroma
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=Docchat
MAX_UPLOAD_MB=20
ALLOWED_EXTENSIONS=pdf,txt,md

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=800
CHUNK_OVERLAP=150

TOP_K=5
MAX_DISTANCE=0.55
HISTORY_TURNS=6

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemma-4-31b-it:free
LLM_FALLBACK_MODELS=nvidia/nemotron-3-super:free
LLM_MAX_TOKENS=1000
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
LLM_GLOBAL_RPM=18
LLM_DAILY_SOFT_LIMIT=45
ALLOW_PAID_MODELS=false
APP_NAME=DocChat

FRONTEND_ORIGIN=http://localhost:5173
